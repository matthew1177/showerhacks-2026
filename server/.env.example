PORT=5173
DISCORD_CLIENT_ID=1553470711308353626
# OAuth2 Client Secret from the Discord Developer Portal (never a VITE_ variable).
DISCORD_CLIENT_SECRET=
# Python image API (../imagegen). Leave IMAGE_API_URL empty to use placeholder images.
IMAGE_API_URL=http://127.0.0.1:8000
# Must match imagegen/.env. Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
IMAGE_API_SECRET=
# Per-image timeout after reaching the front of the local GPU queue.
IMAGE_TIMEOUT_MS=300000
