# Must match server/.env. Use a random secret with at least 16 characters.
IMAGE_API_SECRET=
PORT=8000
# Hosts choose Chroma Flash or SDXL-Turbo in the lobby for each game.
# Model loaded at service startup and used by older requests with no model field:
IMAGE_MODEL=chroma-flash
# Chroma transformer and text encoder weights: int8 (default) or none for FP16 on Mac.
# Activations, embeddings, and the VAE stay in floating point. Turbo is unaffected.
IMAGE_CHROMA_QUANTIZATION=int8
# Per-model quality/speed settings; restart the image service after changing them.
IMAGE_FLASH_SIZE=384
IMAGE_FLASH_STEPS=6
IMAGE_TURBO_SIZE=512
IMAGE_TURBO_STEPS=1
# Legacy IMAGE_SIZE / IMAGE_STEPS affect only IMAGE_MODEL's default profile.
# For scripts using original Chroma HD: IMAGE_MODEL=chroma-hd (512 pixels, 20 steps).
