# Must match server/.env. Use a random secret with at least 16 characters.
IMAGE_API_SECRET=
PORT=8000
# Chroma quality/speed settings; restart the image service after changing them.
# Flash fuses a small Chroma adapter for faster sampling with guidance disabled.
IMAGE_FLASH=1
IMAGE_SIZE=384
IMAGE_STEPS=6
# For the original Chroma HD quality settings: IMAGE_FLASH=0, IMAGE_SIZE=512, IMAGE_STEPS=20.
